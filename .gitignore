# C2C session working directories — large conversation logs + working artifacts
# belong on disk but not in git history
*/c2c/c2c_sessions/

# Paper-building workflow doc — working methodology document, not versioned
PAPER_BUILDING_WORKFLOW.md

# Student data — anonymized but FERPA-adjacent (real student writing).
# Architecture docs and READMEs in these folders stay versioned; CSVs do not.
output-format-bias/data/dual_binary_run_*/*.csv

# API keys — defense in depth; primary keys live in ~/Documents/GitHub/reframe/.env
.env
.env.*
!.env.example

# Local tool scaffolding — machine-local config/state, not shareable
.claude/
mempalace.yaml
entities.json
*.bak-*
.DS_Store

# Python bytecode cache — regenerated locally, shouldn't be tracked
__pycache__/
*.pyc

# Raw model-output test data — large, regenerable, not needed for the public repo
output-format-bias/data/raw_outputs/

# Third-party code cloned for the topology-injection experiment — it's its own
# git repo (not a submodule), re-clone per topology-injection/CLAUDE.md instead
# of vendoring it here
topology-injection/pustovit/
